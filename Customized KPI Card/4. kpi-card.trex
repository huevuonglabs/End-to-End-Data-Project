<?xml version='1.0' encoding='utf-8' ?>
<manifest manifest-version='0.1' xmlns='http://www.tableau.com/xml/extension_manifest'>
  <worksheet-extension id='com.exthost.huevuong.compact-kpi-banner-2' extension-version='1.0.0'>
    <default-locale>en_US</default-locale>
    <name resource-id='name'/>
    <description>Compact KPI Banner</description>
    <author name='huevuong'
            email='tieuhuevuong@gmail.com'
            organization='huevuong'
            website='https://ext.tableauops.com'/>
    <min-api-version>1.12</min-api-version>
    <source-location>
      <url>https://ext.tableauops.com/x/8XwpXAymOjmat3nyPQnjBuYH/</url>
    </source-location>
    <icon></icon>
    <encoding id='date'>
      <display-name>Date</display-name>
      <data-spec>
        <data-type>temporal</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
        <role-type>continuous-dimension</role-type>
      </role-spec>
      <fields max-count='1'/>
      <encoding-icon token='letter-d'/>
      <tooltip>The date field to bucket by Year / Month / Week</tooltip>
    </encoding>
    <encoding id='measure'>
      <display-name>Measure</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
        <role-type>discrete-measure</role-type>
      </role-spec>
      <fields max-count='1'/>
      <encoding-icon token='metric'/>
      <tooltip>The metric to show as the headline number</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id='name'>
      <text locale='en_US'>Compact KPI Banner</text>
    </resource>
  </resources>
</manifest>
